 876:c_library_v2/common/../mavlink_helpers.h **** /**
 877:c_library_v2/common/../mavlink_helpers.h ****  * This is a convenience function which handles the complete MAVLink parsing.
 878:c_library_v2/common/../mavlink_helpers.h ****  * the function will parse one byte at a time and return the complete packet once
 879:c_library_v2/common/../mavlink_helpers.h ****  * it could be successfully decoded. This function will return 0, 1 or
 880:c_library_v2/common/../mavlink_helpers.h ****  * 2 (MAVLINK_FRAMING_INCOMPLETE, MAVLINK_FRAMING_OK or MAVLINK_FRAMING_BAD_CRC)
 881:c_library_v2/common/../mavlink_helpers.h ****  *
 882:c_library_v2/common/../mavlink_helpers.h ****  * Messages are parsed into an internal buffer (one for each channel). When a complete
 883:c_library_v2/common/../mavlink_helpers.h ****  * message is received it is copies into *r_message and the channel's status is
 884:c_library_v2/common/../mavlink_helpers.h ****  * copied into *r_mavlink_status.
 885:c_library_v2/common/../mavlink_helpers.h ****  *
 886:c_library_v2/common/../mavlink_helpers.h ****  * @param chan     ID of the channel to be parsed.
 887:c_library_v2/common/../mavlink_helpers.h ****  *                 A channel is not a physical message channel like a serial port, but a logical pa
 888:c_library_v2/common/../mavlink_helpers.h ****  *                 the communication streams. COMM_NB is the limit for the number of channels
 889:c_library_v2/common/../mavlink_helpers.h ****  *                 on MCU (e.g. ARM7), while COMM_NB_HIGH is the limit for the number of channels i
 890:c_library_v2/common/../mavlink_helpers.h ****  * @param c        The char to parse
 891:c_library_v2/common/../mavlink_helpers.h ****  *
 892:c_library_v2/common/../mavlink_helpers.h ****  * @param r_message NULL if no message could be decoded, otherwise the message data
 893:c_library_v2/common/../mavlink_helpers.h ****  * @param r_mavlink_status if a message was decoded, this is filled with the channel's stats
 894:c_library_v2/common/../mavlink_helpers.h ****  * @return 0 if no message could be decoded, 1 on good message and CRC, 2 on bad CRC
 895:c_library_v2/common/../mavlink_helpers.h ****  *
 896:c_library_v2/common/../mavlink_helpers.h ****  * A typical use scenario of this function call is:
 897:c_library_v2/common/../mavlink_helpers.h ****  *
 898:c_library_v2/common/../mavlink_helpers.h ****  * @code
 899:c_library_v2/common/../mavlink_helpers.h ****  * #include <mavlink.h>
 900:c_library_v2/common/../mavlink_helpers.h ****  *
 901:c_library_v2/common/../mavlink_helpers.h ****  * mavlink_status_t status;
 902:c_library_v2/common/../mavlink_helpers.h ****  * mavlink_message_t msg;
 903:c_library_v2/common/../mavlink_helpers.h ****  * int chan = 0;
 904:c_library_v2/common/../mavlink_helpers.h ****  *
 905:c_library_v2/common/../mavlink_helpers.h ****  *
 906:c_library_v2/common/../mavlink_helpers.h ****  * while(serial.bytesAvailable > 0)
 907:c_library_v2/common/../mavlink_helpers.h ****  * {
 908:c_library_v2/common/../mavlink_helpers.h ****  *   uint8_t byte = serial.getNextByte();
 909:c_library_v2/common/../mavlink_helpers.h ****  *   if (mavlink_frame_char(chan, byte, &msg, &status) != MAVLINK_FRAMING_INCOMPLETE)
 910:c_library_v2/common/../mavlink_helpers.h ****  *     {
 911:c_library_v2/common/../mavlink_helpers.h ****  *     printf("Received message with ID %d, sequence: %d from component %d of system %d", msg.msgid
 912:c_library_v2/common/../mavlink_helpers.h ****  *     }
