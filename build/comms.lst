 927:c_library_v2/common/../mavlink_helpers.h **** /**
 928:c_library_v2/common/../mavlink_helpers.h ****  * Set the protocol version
 929:c_library_v2/common/../mavlink_helpers.h ****  */
 930:c_library_v2/common/../mavlink_helpers.h **** MAVLINK_HELPER void mavlink_set_proto_version(uint8_t chan, unsigned int version)
 931:c_library_v2/common/../mavlink_helpers.h **** {
 932:c_library_v2/common/../mavlink_helpers.h **** 	mavlink_status_t *status = mavlink_get_channel_status(chan);
 933:c_library_v2/common/../mavlink_helpers.h **** 	if (version > 1) {
 934:c_library_v2/common/../mavlink_helpers.h **** 		status->flags &= ~(MAVLINK_STATUS_FLAG_OUT_MAVLINK1);
 935:c_library_v2/common/../mavlink_helpers.h **** 	} else {
 936:c_library_v2/common/../mavlink_helpers.h **** 		status->flags |= MAVLINK_STATUS_FLAG_OUT_MAVLINK1;
 937:c_library_v2/common/../mavlink_helpers.h **** 	}
 938:c_library_v2/common/../mavlink_helpers.h **** }
 939:c_library_v2/common/../mavlink_helpers.h **** 
 940:c_library_v2/common/../mavlink_helpers.h **** /**
 941:c_library_v2/common/../mavlink_helpers.h ****  * Get the protocol version
 942:c_library_v2/common/../mavlink_helpers.h ****  *
 943:c_library_v2/common/../mavlink_helpers.h ****  * @return 1 for v1, 2 for v2
 944:c_library_v2/common/../mavlink_helpers.h ****  */
 945:c_library_v2/common/../mavlink_helpers.h **** MAVLINK_HELPER unsigned int mavlink_get_proto_version(uint8_t chan)
 946:c_library_v2/common/../mavlink_helpers.h **** {
 947:c_library_v2/common/../mavlink_helpers.h **** 	mavlink_status_t *status = mavlink_get_channel_status(chan);
 948:c_library_v2/common/../mavlink_helpers.h **** 	if ((status->flags & MAVLINK_STATUS_FLAG_OUT_MAVLINK1) > 0) {
 949:c_library_v2/common/../mavlink_helpers.h **** 		return 1;
 950:c_library_v2/common/../mavlink_helpers.h **** 	} else {
 951:c_library_v2/common/../mavlink_helpers.h **** 		return 2;
 952:c_library_v2/common/../mavlink_helpers.h **** 	}
 953:c_library_v2/common/../mavlink_helpers.h **** }
