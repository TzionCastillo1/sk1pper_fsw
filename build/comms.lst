 915:c_library_v2/common/../mavlink_helpers.h ****  *
 916:c_library_v2/common/../mavlink_helpers.h ****  * @endcode
 917:c_library_v2/common/../mavlink_helpers.h ****  */
 918:c_library_v2/common/../mavlink_helpers.h **** MAVLINK_HELPER uint8_t mavlink_frame_char(uint8_t chan, uint8_t c, mavlink_message_t* r_message, ma
 919:c_library_v2/common/../mavlink_helpers.h **** {
